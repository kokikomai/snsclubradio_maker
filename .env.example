# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Spreadsheet ID (URLの /d/ と /edit の間の部分)
SPREADSHEET_ID=your_spreadsheet_id_here

# シート名（デフォルト: 質問）
SHEET_NAME=質問

# 質問が入っている列（A, B, C...）
QUESTION_COLUMN=B

# 出力ディレクトリ
OUTPUT_DIR=output

# 過去の原稿ディレクトリ（スコアリング用）
SCRIPTS_DIR=/path/to/SnsClub-radio/past drafts

# スコアリングで選ぶ上位件数（デフォルト: 10）
TOP_QUESTIONS_COUNT=10
